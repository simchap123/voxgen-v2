<Project>

  <!--
    Repo-wide build properties. Inherited by every .csproj under this directory.
    PRD §6 — single source of truth; consistent compiler discipline across all projects.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Company>VoxGen</Company>
    <Product>VoxGen</Product>
    <Authors>VoxGen</Authors>
    <Copyright>© VoxGen</Copyright>
  </PropertyGroup>

</Project>
