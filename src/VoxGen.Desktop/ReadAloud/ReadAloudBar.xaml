<Window x:Class="VoxGen.Desktop.ReadAloud.ReadAloudBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoxGen read aloud"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        FontFamily="{DynamicResource DmSansFont}">

  <!--
    Tiny read-aloud controls: slower · rate · faster · pause/play · stop · copy.
    Never takes focus (WS_EX_NOACTIVATE set in code) so the app being read keeps the keyboard.
  -->
  <Window.Resources>
    <Style x:Key="BarButton" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="14">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Icons are drawn as geometry, not an icon font, so they render identically everywhere. -->
    <Style x:Key="IconStroke" TargetType="Path">
      <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style x:Key="IconFill" TargetType="Path">
      <Setter Property="Fill" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource BackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="18"
          Padding="6,4"
          Margin="8">
    <Border.Effect>
      <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
    </Border.Effect>
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="StatusDot"
                 Text="●"
                 FontSize="9"
                 Foreground="{DynamicResource PrimaryBrush}"
                 VerticalAlignment="Center"
                 Margin="6,0,6,0" />

      <Button Style="{StaticResource BarButton}" ToolTip="Slower" Click="OnSlower">
        <Path Style="{StaticResource IconStroke}" Data="M0,5 H10" Height="2" />
      </Button>
      <TextBlock x:Name="RateText"
                 Text="1×"
                 MinWidth="34"
                 TextAlignment="Center"
                 FontSize="12"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource ForegroundBrush}" />
      <Button Style="{StaticResource BarButton}" ToolTip="Faster" Click="OnFaster">
        <Path Style="{StaticResource IconStroke}" Data="M5,0 V10 M0,5 H10" />
      </Button>

      <Rectangle Width="1" Height="16" Margin="4,0" Fill="{DynamicResource BorderBrush}" />

      <Button x:Name="PauseButton" Style="{StaticResource BarButton}" ToolTip="Pause" Click="OnPause">
        <Path x:Name="PauseIcon" Style="{StaticResource IconFill}" Data="M1,0 H4 V10 H1 Z M6,0 H9 V10 H6 Z" />
      </Button>
      <Button Style="{StaticResource BarButton}" ToolTip="Stop" Click="OnStop">
        <Path Style="{StaticResource IconFill}" Data="M0,0 H10 V10 H0 Z" Width="9" Height="9" />
      </Button>
      <Button x:Name="CopyButton" Style="{StaticResource BarButton}" ToolTip="Copy text" Click="OnCopy">
        <Path x:Name="CopyIcon" Style="{StaticResource IconStroke}" Data="M3.5,0.5 H10.5 V7.5 H3.5 Z M0.5,3.5 V10.5 H7.5" />
      </Button>
    </StackPanel>
  </Border>
</Window>
