<!--
  VoxGen brand resource dictionary — PRD §15, CLAUDE.md "UI / brand".
  Warm light theme: sage on cream. Do not import this anywhere yet; integration
  into App.xaml is wired up separately. Source HSL values are in CLAUDE.md;
  values below are the precomputed sRGB equivalents.

  TODO: bundle DM Sans .ttf as a Resource build action so DmSansFont resolves
  to the bundled face instead of relying on a system install. Until that lands,
  the fallback to Segoe UI keeps the UI readable.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ============================================================
       Palette — semantic brushes (PRD §15, CLAUDE.md UI/brand)
       ============================================================ -->
  <SolidColorBrush x:Key="PrimaryBrush"            Color="#FF4C8C6B" />
  <SolidColorBrush x:Key="PrimaryForegroundBrush"  Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="BackgroundBrush"         Color="#FFF8F4EC" />
  <SolidColorBrush x:Key="ForegroundBrush"         Color="#FF21262E" />
  <SolidColorBrush x:Key="MutedForegroundBrush"    Color="#FF6B7079" />
  <SolidColorBrush x:Key="BorderBrush"             Color="#FFE6E2D8" />
  <SolidColorBrush x:Key="AccentBrush"             Color="#FFCBE0D5" />
  <SolidColorBrush x:Key="DestructiveBrush"        Color="#FFDC2C2C" />

  <!-- Sidebar surface — a hair darker than background, common in the v1 layout. -->
  <SolidColorBrush x:Key="SidebarBackgroundBrush"  Color="#FFF1ECE2" />
  <SolidColorBrush x:Key="HoverBrush"              Color="#FFEDE7DA" />

  <!-- ============================================================
       Typography
       ============================================================ -->
  <FontFamily x:Key="DmSansFont">DM Sans, Segoe UI</FontFamily>

  <sys:Double x:Key="SmallFontSize">11</sys:Double>
  <sys:Double x:Key="BodyFontSize">13</sys:Double>
  <sys:Double x:Key="HeadingFontSize">18</sys:Double>
  <sys:Double x:Key="TitleFontSize">22</sys:Double>

  <!-- ============================================================
       Base text styles
       ============================================================ -->
  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DmSansFont}" />
    <Setter Property="FontSize"   Value="{StaticResource BodyFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
    <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
    <Setter Property="FontSize"   Value="{StaticResource SmallFontSize}" />
  </Style>

  <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DmSansFont}" />
    <Setter Property="FontSize"   Value="{StaticResource HeadingFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="Margin"     Value="0,0,0,4" />
  </Style>

  <Style x:Key="TitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DmSansFont}" />
    <Setter Property="FontSize"   Value="{StaticResource TitleFontSize}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>

  <!-- Implicit default TextBlock — anything without an explicit style still picks up brand type. -->
  <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}" />

  <!-- ============================================================
       Buttons — restrained, single primary style
       ============================================================ -->
  <Style x:Key="PrimaryButtonStyle" TargetType="Button">
    <Setter Property="FontFamily"  Value="{StaticResource DmSansFont}" />
    <Setter Property="FontSize"    Value="{StaticResource BodyFontSize}" />
    <Setter Property="FontWeight"  Value="Medium" />
    <Setter Property="Foreground"  Value="{StaticResource PrimaryForegroundBrush}" />
    <Setter Property="Background"  Value="{StaticResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding"     Value="14,7" />
    <Setter Property="Cursor"      Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Default Button — secondary, since most buttons in a settings window are secondary. -->
  <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}" />

  <!-- ============================================================
       Sidebar nav item — a flat button that highlights when selected.
       Selection state is driven by IsChecked (used via ToggleButton/RadioButton).
       ============================================================ -->
  <Style x:Key="SidebarNavItemStyle" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource DmSansFont}" />
    <Setter Property="FontSize"   Value="{StaticResource BodyFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding"    Value="12,7" />
    <Setter Property="Margin"     Value="0,0,0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor"     Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
              <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}" />
              <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       CheckBox — used for the cleanup toggle. Simple, brand-tinted.
       (A true iOS-style toggle switch can replace this later — for the skeleton,
        a clean accent-coloured checkbox keeps the dependency surface zero.)
       ============================================================ -->
  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource DmSansFont}" />
    <Setter Property="FontSize"   Value="{StaticResource BodyFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="Cursor"     Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Box"
                    Width="18" Height="18"
                    CornerRadius="4"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1.2"
                    Background="Transparent"
                    VerticalAlignment="Center">
              <Path x:Name="Check"
                    Data="M 3.5 8.5 L 7 12 L 14 4.5"
                    Stroke="{StaticResource PrimaryForegroundBrush}"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box"   Property="Background"  Value="{StaticResource PrimaryBrush}" />
              <Setter TargetName="Box"   Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
              <Setter TargetName="Check" Property="Visibility"  Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
