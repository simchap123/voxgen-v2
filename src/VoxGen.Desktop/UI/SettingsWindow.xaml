<Window x:Class="VoxGen.Desktop.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoxGen Settings"
        Width="820" Height="560"
        MinWidth="640" MinHeight="480"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource DmSansFont}"
        FontSize="{DynamicResource BodyFontSize}"
        Foreground="{DynamicResource ForegroundBrush}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="/Assets/voxgen.ico"
        PreviewKeyDown="OnWindowPreviewKeyDown">

  <!--
    Layout: 200px sidebar + content area. Mirrors v1's Sidebar.tsx structure
    (CLAUDE.md UI/brand). Closing hides rather than disposes — the tray-resident
    app must be able to reopen this window cheaply (PRD §5.1, §8.1).
  -->

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============== Sidebar ============== -->
    <Border Grid.Column="0"
            Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <StackPanel Margin="14,16,14,14">

        <!-- Brand mark -->
        <StackPanel Orientation="Horizontal" Margin="2,0,0,22">
          <Border Width="28" Height="28"
                  CornerRadius="6"
                  Background="{DynamicResource PrimaryBrush}"
                  VerticalAlignment="Center">
            <TextBlock Text="V"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                       FontWeight="Bold"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="VoxGen"
                     FontWeight="Bold"
                     FontSize="14"
                     VerticalAlignment="Center"
                     Margin="10,0,0,0" />
        </StackPanel>

        <!-- Section nav. RadioButtons in a single group give us mutually-exclusive
             selection for free; the Click handlers swap visible content. -->
        <RadioButton x:Name="NavGeneral"
                     Style="{DynamicResource SidebarNavItemStyle}"
                     GroupName="SettingsSection"
                     IsChecked="True"
                     Content="General"
                     Click="OnNavGeneralClick" />
        <RadioButton x:Name="NavApiKey"
                     Style="{DynamicResource SidebarNavItemStyle}"
                     GroupName="SettingsSection"
                     Content="API key"
                     Click="OnNavApiKeyClick" />
        <RadioButton x:Name="NavReadAloud"
                     Style="{DynamicResource SidebarNavItemStyle}"
                     GroupName="SettingsSection"
                     Content="Read aloud"
                     Click="OnNavReadAloudClick" />
        <RadioButton x:Name="NavHistory"
                     Style="{DynamicResource SidebarNavItemStyle}"
                     GroupName="SettingsSection"
                     Content="History"
                     Click="OnNavHistoryClick" />
        <RadioButton x:Name="NavAbout"
                     Style="{DynamicResource SidebarNavItemStyle}"
                     GroupName="SettingsSection"
                     Content="About"
                     Click="OnNavAboutClick" />
      </StackPanel>
    </Border>

    <!-- ============== Content ============== -->
    <ScrollViewer Grid.Column="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

      <Grid Margin="36,32,36,32">
        <!-- General -->
        <StackPanel x:Name="GeneralPanel">
          <TextBlock Text="General"
                     Style="{DynamicResource TitleTextStyle}"
                     Margin="0,0,0,4" />
          <TextBlock Text="Core dictation behaviour."
                     Style="{DynamicResource MutedTextStyle}"
                     Margin="0,0,0,28" />

          <!-- AI cleanup row. Bound to AppSettings.CleanupEnabled through
               SettingsService.TryUpdate; UI reflects persisted state (PRD §10 rule 4). -->
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="AI cleanup"
                         FontWeight="SemiBold"
                         Margin="0,0,0,2" />
              <TextBlock Text="Remove filler words, fix grammar and punctuation, format the text. When off, the raw transcript is used."
                         Style="{DynamicResource MutedTextStyle}" />
            </StackPanel>
            <CheckBox x:Name="CleanupToggle"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Click="OnCleanupToggleClick" />
          </Grid>

          <!-- Live typing (opt-in, experimental). Default OFF; flows through SettingsService. -->
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Live typing (experimental)" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="Type words as you speak instead of pasting when you release. Lower latency feel, but less accurate and more CPU."
                         Style="{DynamicResource MutedTextStyle}" />
            </StackPanel>
            <CheckBox x:Name="LiveTypingToggle"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Click="OnLiveTypingToggleClick" />
          </Grid>

          <!-- Microphone picker. Persists SelectedMicrophoneId (authoritative) + name (display)
               via SettingsService; App re-initializes capture when the id changes. -->
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Microphone" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="The device VoxGen records from."
                         Style="{DynamicResource MutedTextStyle}" />
            </StackPanel>
            <ComboBox x:Name="MicrophoneCombo"
                      Grid.Column="1"
                      Width="240"
                      VerticalAlignment="Center"
                      DisplayMemberPath="Name"
                      SelectionChanged="OnMicrophoneChanged" />
          </Grid>

          <!-- Hotkey recorder. Captures the next chord into HotkeyValue. -->
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Hotkey" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="The key you hold (or tap) to dictate. Press Esc while recording to cancel."
                         Style="{DynamicResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="10,5" MinWidth="120">
                <TextBlock x:Name="HotkeyDisplay"
                           Text="RightAlt"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}" />
              </Border>
              <Button x:Name="HotkeyRecordButton"
                      Content="Change"
                      Margin="8,0,0,0"
                      Padding="12,5"
                      Click="OnHotkeyRecordClick" />
            </StackPanel>
          </Grid>

          <!-- Activation mode. v1 scope: Hold + Toggle only (PRD §8.3). -->
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Activation" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="Hold to record while pressed, or tap once to start and again to stop."
                         Style="{DynamicResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton x:Name="ModeHold" GroupName="HotkeyMode" Content="Hold"
                           Margin="0,0,14,0" VerticalAlignment="Center" Click="OnHotkeyModeChanged" />
              <RadioButton x:Name="ModeToggle" GroupName="HotkeyMode" Content="Toggle"
                           VerticalAlignment="Center" Click="OnHotkeyModeChanged" />
            </StackPanel>
          </Grid>

        </StackPanel>

        <!-- API key -->
        <StackPanel x:Name="ApiKeyPanel" Visibility="Collapsed">
          <TextBlock Text="API key"
                     Style="{DynamicResource TitleTextStyle}"
                     Margin="0,0,0,4" />
          <TextBlock Text="VoxGen sends your audio straight to Groq with your own key. No account, no VoxGen server."
                     Style="{DynamicResource MutedTextStyle}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,28" />

          <Border Background="{DynamicResource AccentBrush}"
                  CornerRadius="8"
                  Padding="18,16"
                  Margin="0,0,0,16">
            <StackPanel>
              <TextBlock x:Name="ApiKeyStatusText"
                         Text="No key saved"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource ForegroundBrush}"
                         Margin="0,0,0,2" />
              <TextBlock x:Name="ApiKeyStatusDetail"
                         Text="Dictation needs a Groq API key. Groq has a free tier."
                         Style="{DynamicResource MutedTextStyle}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="ApiKeyBox"
                             Grid.Column="0"
                             Padding="6,5"
                             VerticalContentAlignment="Center"
                             KeyDown="OnApiKeyBoxKeyDown" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                  <Button x:Name="SaveApiKeyButton"
                          Content="Save"
                          Style="{DynamicResource PrimaryButtonStyle}"
                          Padding="16,6"
                          Click="OnSaveApiKeyClick" />
                  <Button x:Name="TestApiKeyButton"
                          Content="Test"
                          Padding="14,6"
                          Margin="8,0,0,0"
                          Click="OnTestApiKeyClick" />
                  <Button x:Name="RemoveApiKeyButton"
                          Content="Remove"
                          Padding="14,6"
                          Margin="8,0,0,0"
                          Click="OnRemoveApiKeyClick" />
                </StackPanel>
              </Grid>
              <TextBlock x:Name="ApiKeyResultText"
                         Style="{DynamicResource MutedTextStyle}"
                         TextWrapping="Wrap"
                         Margin="0,10,0,0"
                         Visibility="Collapsed" />
            </StackPanel>
          </Border>

          <TextBlock Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap">
            <Run Text="Get a key at " />
            <Hyperlink NavigateUri="https://console.groq.com/keys" RequestNavigate="OnHyperlinkNavigate">console.groq.com/keys</Hyperlink>
            <Run Text=". The key is encrypted with your Windows account and stored only on this PC." />
          </TextBlock>
        </StackPanel>

        <!-- Read aloud -->
        <StackPanel x:Name="ReadAloudPanel" Visibility="Collapsed">
          <TextBlock Text="Read aloud"
                     Style="{DynamicResource TitleTextStyle}"
                     Margin="0,0,0,4" />
          <TextBlock Text="Hear any text on screen in a Groq voice."
                     Style="{DynamicResource MutedTextStyle}"
                     Margin="0,0,0,20" />

          <Border Background="{DynamicResource AccentBrush}"
                  CornerRadius="8"
                  Padding="16,12"
                  Margin="0,0,0,24">
            <StackPanel>
              <TextBlock Text="How to use it" FontWeight="SemiBold" Margin="0,0,0,6"
                         Foreground="{DynamicResource ForegroundBrush}" />
              <TextBlock x:Name="ReadAloudHowTo"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource ForegroundBrush}"
                         Text="1. Hold Ctrl+Shift.  2. Point at any text and keep the mouse still for half a second.  3. Let go — it keeps reading. To read a whole section, select it first, then point at it. A small bar at the bottom lets you slow down, speed up, pause, stop or copy." />
            </StackPanel>
          </Border>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Read aloud on hover" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="Turn the feature on or off."
                         Style="{DynamicResource MutedTextStyle}" />
            </StackPanel>
            <CheckBox x:Name="HoverReadToggle"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Click="OnHoverReadToggleClick" />
          </Grid>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Shortcut" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="The keys you hold while pointing."
                         Style="{DynamicResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton x:Name="ShortcutCtrlShift" GroupName="ReadShortcut" Content="Ctrl+Shift"
                           Margin="0,0,14,0" VerticalAlignment="Center" Click="OnShortcutChanged" />
              <RadioButton x:Name="ShortcutCtrlAlt" GroupName="ReadShortcut" Content="Ctrl+Alt"
                           VerticalAlignment="Center" Click="OnShortcutChanged" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Voice" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="Hannah, Autumn and Diana are female; Troy, Austin and Daniel are male."
                         Style="{DynamicResource MutedTextStyle}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ComboBox x:Name="VoiceCombo"
                        Width="120"
                        VerticalAlignment="Center"
                        SelectionChanged="OnVoiceChanged" />
              <Button Content="Preview"
                      Padding="12,5"
                      Margin="8,0,0,0"
                      Click="OnPreviewVoiceClick" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Speed" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="Also adjustable live from the bar while it reads."
                         Style="{DynamicResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Slider x:Name="SpeedSlider"
                      Width="180"
                      Minimum="0.5" Maximum="2.5"
                      TickFrequency="0.25" IsSnapToTickEnabled="True"
                      VerticalAlignment="Center"
                      ValueChanged="OnSpeedChanged" />
              <TextBlock x:Name="SpeedLabel"
                         Text="1×"
                         MinWidth="40"
                         Margin="10,0,0,0"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- History -->
        <StackPanel x:Name="HistoryPanel" Visibility="Collapsed">
          <TextBlock Text="History"
                     Style="{DynamicResource TitleTextStyle}"
                     Margin="0,0,0,4" />
          <TextBlock Text="Your past dictations, newest first. Saved on this PC only."
                     Style="{DynamicResource MutedTextStyle}"
                     Margin="0,0,0,28" />

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Save transcripts" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="Keep the text of every dictation."
                         Style="{DynamicResource MutedTextStyle}" />
            </StackPanel>
            <CheckBox x:Name="SaveTextToggle"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Click="OnSaveTextToggleClick" />
          </Grid>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Save recordings" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="Keep the audio of every dictation as a WAV file."
                         Style="{DynamicResource MutedTextStyle}" />
            </StackPanel>
            <CheckBox x:Name="SaveAudioToggle"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Click="OnSaveAudioToggleClick" />
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
            <Button Content="Open recordings folder" Padding="14,6" Click="OnOpenRecordingsClick" />
            <Button x:Name="ClearHistoryButton" Content="Clear history" Padding="14,6" Margin="8,0,0,0"
                    Click="OnClearHistoryClick" />
            <Button x:Name="ConfirmClearButton" Content="Delete all history and recordings"
                    Padding="14,6" Margin="8,0,0,0" Visibility="Collapsed"
                    Foreground="{DynamicResource DestructiveBrush}"
                    Click="OnConfirmClearClick" />
          </StackPanel>

          <TextBlock x:Name="HistoryEmptyText"
                     Text="No dictations yet."
                     Style="{DynamicResource MutedTextStyle}"
                     Visibility="Collapsed" />

          <ItemsControl x:Name="HistoryList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                      <TextBlock Text="{Binding When}"
                                 Style="{DynamicResource MutedTextStyle}"
                                 Margin="0,0,0,2" />
                      <TextBlock Text="{Binding Text}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                      <Button Content="Copy" Padding="10,4" Tag="{Binding}"
                              Visibility="{Binding CopyVisibility}"
                              Click="OnHistoryCopyClick" />
                      <Button Content="Play" Padding="10,4" Margin="6,0,0,0" Tag="{Binding}"
                              Visibility="{Binding PlayVisibility}"
                              Click="OnHistoryPlayClick" />
                      <Button Content="Delete" Padding="10,4" Margin="6,0,0,0" Tag="{Binding}"
                              Foreground="{DynamicResource DestructiveBrush}"
                              Click="OnHistoryDeleteClick" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- About -->
        <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
          <TextBlock Text="About"
                     Style="{DynamicResource TitleTextStyle}"
                     Margin="0,0,0,4" />
          <TextBlock Text="VoxGen — a free, tiny native dictation utility."
                     Style="{DynamicResource MutedTextStyle}"
                     Margin="0,0,0,28" />

          <Border Background="{DynamicResource AccentBrush}"
                  CornerRadius="8"
                  Padding="18,16"
                  Margin="0,0,0,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText"
                           Text="Version"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,2" />
                <TextBlock x:Name="UpdateStatusText"
                           Text="Check GitHub for a newer version."
                           Style="{DynamicResource MutedTextStyle}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CheckUpdateButton"
                        Content="Check for updates"
                        Padding="14,6"
                        Click="OnCheckUpdateClick" />
                <Button x:Name="InstallUpdateButton"
                        Content="Update now"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Padding="16,6"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"
                        Click="OnInstallUpdateClick" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Style="{DynamicResource MutedTextStyle}"
                     Text="Press, talk, paste, done." />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
