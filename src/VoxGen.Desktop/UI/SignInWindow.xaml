<Window x:Class="VoxGen.Desktop.UI.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to VoxGen"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource DmSansFont}"
        FontSize="{DynamicResource BodyFontSize}"
        Foreground="{DynamicResource ForegroundBrush}"
        Icon="/Assets/voxgen.ico"
        ShowInTaskbar="True">

  <!-- Modernized sign-in (PRD §8.2). Warm-light brand: sage on cream, white elevated inputs
       with a sage focus ring, one filled primary action + a quiet secondary. -->
  <Window.Resources>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource DmSansFont}" />
      <Setter Property="FontSize"   Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="Margin"     Value="2,0,0,5" />
    </Style>

    <!-- White, rounded, sage-focus text field. -->
    <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{DynamicResource DmSansFont}" />
      <Setter Property="FontSize"   Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd"
                    Background="#FFFFFFFF"
                    CornerRadius="9"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1.3">
              <ScrollViewer x:Name="PART_ContentHost" Margin="12,10" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush"    Value="{DynamicResource PrimaryBrush}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="1.7" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
      <Setter Property="FontFamily" Value="{DynamicResource DmSansFont}" />
      <Setter Property="FontSize"   Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Bd"
                    Background="#FFFFFFFF"
                    CornerRadius="9"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1.3">
              <ScrollViewer x:Name="PART_ContentHost" Margin="12,10" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush"    Value="{DynamicResource PrimaryBrush}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="1.7" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel Margin="34,32,34,30">

    <!-- Brand mark: real logo + wordmark -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,24">
      <Image Source="/Assets/voxgen-256.png" Width="36" Height="36"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <TextBlock Text="VoxGen" FontWeight="Bold" FontSize="17"
                 VerticalAlignment="Center" Margin="11,0,0,0" />
    </StackPanel>

    <TextBlock Text="Welcome" FontSize="25" FontWeight="Bold" Margin="0,0,0,5" />
    <TextBlock Text="Sign in or create an account to start dictating."
               Foreground="{DynamicResource MutedForegroundBrush}" FontSize="13"
               TextWrapping="Wrap" Margin="0,0,0,1" />
    <TextBlock Text="No credit card · 30-day free trial."
               Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12"
               TextWrapping="Wrap" Margin="0,0,0,24" />

    <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}" />
    <TextBox x:Name="EmailBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15" />

    <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" />
    <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,6" />

    <!-- Inline error (e.g. wrong password, rate-limited). Hidden until set. -->
    <Border x:Name="StatusContainer" Visibility="Collapsed"
            Background="#FFFCE9E9" CornerRadius="8" Padding="11,8" Margin="0,8,0,0">
      <TextBlock x:Name="StatusText"
                 Foreground="{DynamicResource DestructiveBrush}"
                 FontSize="12.5" TextWrapping="Wrap" />
    </Border>

    <Button x:Name="SignInButton" Content="Sign in"
            Style="{DynamicResource PrimaryButtonStyle}"
            Height="44" FontSize="14" Margin="0,18,0,10"
            Click="OnSignInClick" />

    <Button x:Name="SignUpButton" Content="Create account"
            Style="{DynamicResource SecondaryButtonStyle}"
            Height="42" FontSize="14"
            Click="OnSignUpClick" />
  </StackPanel>
</Window>
