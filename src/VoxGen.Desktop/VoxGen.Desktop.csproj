<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms interop for System.Windows.Forms.NotifyIcon (tray) — built into .NET, not a third-party package. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VoxGen.Desktop</RootNamespace>
    <AssemblyName>VoxGen</AssemblyName>
    <AssemblyTitle>VoxGen</AssemblyTitle>
    <Version>2.0.10</Version>
    <FileVersion>2.0.10.0</FileVersion>
    <InformationalVersion>2.0.10-preview</InformationalVersion>
    <!-- Branded exe / taskbar icon (PRD §15). -->
    <ApplicationIcon>Assets\voxgen.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    DPAPI (System.Security.Cryptography.ProtectedData) needs NO package reference on
    net10.0-windows — the type ships in the Windows Desktop framework. Confirmed by NU1510
    ("will not be pruned… likely unnecessary"). This vindicates PRD §6.2's "Built into .NET".
  -->

  <ItemGroup>
    <!--
      UseWindowsForms + ImplicitUsings adds global `using System.Windows.Forms` and
      `using System.Drawing`, which collide with WPF's System.Windows / System.Windows.Media
      (Application, MessageBox, Clipboard, Color, Brush, …). The only WinForms/Drawing consumer is
      Tray/ (explicit `WinForms =` alias + explicit `using System.Drawing`), so drop both implicit
      globals to keep the WPF types unambiguous everywhere else.
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!--
    Sanctioned third-party packages (PRD §6.2):
      NAudio                — microphone capture (this slice)
      Microsoft.Data.Sqlite — when /History lands
      Velopack              — when /Updater lands
    Anything else requires explicit approval.
  -->
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!--
    Local on-device Whisper STT (Whisper.net + native ggml binaries) was REMOVED once the managed
    cloud path shipped — it bundled ~12 MB of native libs across several RIDs for a provider that's
    never instantiated in cloud mode. PRD §6.2 always scoped it as a preview-only stopgap. The app
    now uses VoxGenManagedProvider (cloud) and falls back to StubTranscriptionProvider when no
    backend is configured.
  -->

  <ItemGroup>
    <!-- Brand resources — merged in App.xaml so resource keys resolve everywhere. -->
    <Page Update="UI\Resources\Brand.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <!-- Logo as a WPF Resource so the tray icon and window chrome can load it at runtime
         (pack URI / Window.Icon). The same file is also embedded in the exe via ApplicationIcon. -->
    <Resource Include="Assets\voxgen.ico" />
    <!-- High-res PNG logo for in-window brand marks (sign-in window, etc.) — crisper than the
         small .ico entries when drawn at 32–48px. -->
    <Resource Include="Assets\voxgen-256.png" />
  </ItemGroup>

</Project>
